# ============================================================
# Vivero IoT (vivero_iot) - .gitignore
# ============================================================

# --- Builds de PlatformIO ---
.pio/
.pioenvs/
.piolibdeps/
build.log
upload.log

# --- VS Code ---
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.vscode/*.log

# --- SUPABASE: secretos y temporales ---
# NUNCA versionar credenciales (contiene SERVICE_ROLE_KEY / ANON_KEY / JWT_SECRET).
supabase/.env.local
supabase/.env
# Temporales del CLI (cache de imágenes de funciones, estado del stack).
supabase/.temp/
supabase/.branches/
supabase/snippets/

# --- Python (web/server.py, tools/*.py) ---
__pycache__/
*.pyc

# --- Datos en runtime (mock backend y capturas) ---
# devices.json contiene auth_token reales del dispositivo.
tools/devices.json
tools/telemetry.jsonl
tools/events.jsonl
tools/overrides.json
tools/config.json
tools/*.log
tools/*.err
tools/__pycache__/
tools/serial_*.txt
tools/capture_*.txt

# --- Documentos binarios de especificación (versión fuente en docs/*.md) ---
*.docx

# --- Varios ---
*.tmp
*~
Thumbs.db
